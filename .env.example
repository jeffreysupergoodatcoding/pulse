# LLM — Gemini (default) or any OpenAI-compatible endpoint
LLM_API_KEY=your_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL_NAME=gemini-2.5-flash
LLM_EMBEDDING_MODEL=gemini-embedding-001

# Zep Cloud — knowledge graph + episodic memory
ZEP_API_KEY=your_zep_key_here

# Reddit — create a "script" app at reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=pulse/1.0 by u/your_username

# Twitter / X (optional — Basic tier required, $100/mo)
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=

# YouTube Data API v3 (optional — free, 10k quota/day)
YOUTUBE_API_KEY=

# Redis (optional — used for future task queue / pub-sub)
REDIS_URL=redis://localhost:6379/0

# Simulation defaults
DEFAULT_SIM_ROUNDS=50
DEFAULT_N_AGENTS=100
DEFAULT_N_ARCHETYPES=8
SENTIMENT_SCORER_MODE=llm

# Flask
FLASK_SECRET_KEY=change-me-in-production
FLASK_DEBUG=true
BACKEND_PORT=5001
